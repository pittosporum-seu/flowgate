<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nav_header_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/flow_panel"
    android:orientation="vertical"
    android:paddingStart="@dimen/padding_spacing_dp20"
    android:paddingTop="@dimen/padding_spacing_dp24"
    android:paddingEnd="@dimen/padding_spacing_dp20"
    android:paddingBottom="@dimen/padding_spacing_dp16">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0"
        android:text="@string/app_name"
        android:textColor="@color/flow_text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/nav_header_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_spacing_dp10"
        android:background="@drawable/flow_glass_panel"
        android:paddingStart="@dimen/padding_spacing_dp12"
        android:paddingTop="@dimen/padding_spacing_dp6"
        android:paddingEnd="@dimen/padding_spacing_dp12"
        android:paddingBottom="@dimen/padding_spacing_dp6"
        android:text="@string/flow_status_disconnected"
        android:textColor="@color/flow_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/nav_header_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_spacing_dp12"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/flow_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/nav_header_node"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_spacing_dp4"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/flow_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
